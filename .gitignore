
# ==========================================
# React Application - .gitignore
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Production builds
dist/
build/
out/
.next/
.vercel/
.turbo/

# Environment variables and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Keep environment template
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test coverage
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Cache
.cache/
.parcel-cache/
.vite/
.eslintcache
.stylelintcache
*.cache

# Temporary files
tmp/
temp/
*.tmp
*.temp

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# IDE / Editor files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local certificates
*.pem
*.key

# Optional local uploads
uploads/
